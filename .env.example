PORT=3000
HOST=127.0.0.1
# Enable only behind a trusted ingress; verify forwarded IP handling on deployment.
TRUST_PROXY=false
# Required for voice mode. Never expose this to the browser.
ASSEMBLYAI_API_KEY=
VOICE_DEMO_ENABLED=true
VOICE_MAX_CONCURRENT=2
VOICE_DAILY_TOKEN_LIMIT=50
REQUEST_LOG_ENABLED=true
